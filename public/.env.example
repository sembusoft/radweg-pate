# Radwegpate – Zugangsdaten (Vorlage)
#
# Als .env neben config.php ablegen (Server: /www/htdocs/w0XXXXXX/radweg-pate.de/.env)
# und ausfüllen. Die .env steht NIE im Repository und wird vom Deploy nie übertragen
# oder gelöscht. Von außen gesperrt (public/.htaccess); der Deploy prüft das.
# Werte mit Leerzeichen oder " #" in Anführungszeichen setzen.

# Einmaliger Einrichtungscode für die Ersteinrichtung (mindestens 20 Zeichen).
# Erzeugen: php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
# Nach der Einrichtung (Passwort in der Datenbank) ohne Wirkung.
INSTALL_TOKEN=

# Datenbank: MariaDB 10.11 bei all-inkl (KAS → Datenbanken). Gemeinsame Datenbank mehrerer
# Projekte – Radwegpate legt nur Tabellen mit dem Präfix radpate_ an.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Maximale Größe je Foto in MB (PHP-Uploadgrenze beachten).
MAX_UPLOAD_MB=8
