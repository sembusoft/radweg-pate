# Radwegpate – Apache-Regeln (all-inkl)

Options -Indexes

# Privater Datenordner (Tagebuch, Fotos, Passwort-Hash) liegt im Webroot:
# jeder Zugriff von außen endet mit 404 – unabhängig von der .htaccess,
# die die App zusätzlich im Ordner selbst anlegt.
RedirectMatch 404 "(?i)^/(.*/)?radwegpate_private(/|$)"

# Datenbank-Skripte und Migrationen (db/) laufen nur auf der Kommandozeile (Deploy per SSH):
# von außen nie erreichbar. Die Skripte selbst brechen außerhalb der CLI zusätzlich ab.
RedirectMatch 404 "(?i)^/(.*/)?db(/|$)"
# PHP-Bausteine (lib/) nur zum Einbinden, nie direkt aufrufbar.
RedirectMatch 404 "(?i)^/(.*/)?lib(/|$)"

# Konfiguration und Hilfsdateien nie direkt ausliefern
<FilesMatch "^(config(\.example)?\.php|version\.php|\..*)$">
    Require all denied
</FilesMatch>

# dl.<domain> (Download-Seite für GPX aus der iPhone-App) liefert nur gpx.php, api.php und Assets;
# alles andere leitet auf die Hauptdomain um. api.php selbst lässt dort nur GPX mit Schlüssel zu.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^dl\.(.+)$ [NC]
    RewriteRule !^(gpx\.php|api\.php|assets/.*)$ https://%1/ [R=302,L]
</IfModule>

<IfModule mod_headers.c>
    # Service Worker und Manifest immer frisch prüfen, sonst bleibt eine alte
    # App-Version auf dem Handy hängen.
    <FilesMatch "^(sw\.js|manifest\.webmanifest|icons\.svg|theme-init\.js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Versionierte Assets (?v=...) dürfen lange im Cache bleiben.
    <FilesMatch "^(?!(sw\.js|icons\.svg|theme-init\.js)$).+\.(css|js|png|svg)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
